NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reservas
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
SUPERADMIN_EMAIL=tu-correo-google@ejemplo.com
# Mercado Pago Marketplace (señas por complejo)
APP_URL=http://localhost:5173
MERCADOPAGO_CLIENT_ID=your-marketplace-application-id
MERCADOPAGO_CLIENT_SECRET=your-marketplace-application-secret
MERCADOPAGO_OAUTH_REDIRECT_URI=http://localhost:3001/api/pagos/mercadopago/oauth/callback
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret
MERCADOPAGO_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
MERCADOPAGO_OAUTH_STATE_SECRET=replace-with-another-long-random-secret
# Suscripciones NEW MATCH (checkout alojado; independiente del OAuth de cada complejo)
MERCADOPAGO_SUBSCRIPTIONS_ACCESS_TOKEN=your-subscriptions-test-access-token
MERCADOPAGO_SUBSCRIPTIONS_WEBHOOK_SECRET=your-subscriptions-webhook-secret
MERCADOPAGO_SUBSCRIPTIONS_WEBHOOK_URL=http://localhost:3001/api/pagos/mercadopago/suscripciones/webhook
# Avisos por email (dominio remitente verificado en Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=NEW MATCH <avisos@tu-dominio.com>
# Cron diario: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-long-random-secret
